{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delphi-behavior-contracts-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "ACCESS_MODE": "freemium"
  }
}
